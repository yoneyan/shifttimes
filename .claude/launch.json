{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "manage.py", "runserver", "8000"],
      "port": 8000
    },
    {
      "name": "django-dev-onpremise",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ONPREMISE_MODE=true",
        "SITE_NAME=社内シフト管理",
        "uv", "run", "python", "manage.py", "runserver", "8001"
      ],
      "port": 8001
    }
  ]
}
